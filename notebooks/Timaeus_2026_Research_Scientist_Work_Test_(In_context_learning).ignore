      "  Avg Cross-Entropy Loss: 2.030\n",
      "  Avg KL to Bayesian: 0.274\n",
      "  Avg KL from Uniform: 0.504\n",
      "  Positions evaluated: 149\n",
      "\n",
      "Computing metrics for random_walk...\n",
      "\n",
      "Random Walk Summary:\n",
      "  Avg Cross-Entropy Loss: 1.551\n",
      "  Avg KL to Bayesian: 0.516\n",
      "  Avg KL from Uniform: 1.119\n",
      "  Positions evaluated: 149\n",
      "\n",
      "Phase 3 completed successfully!\n"
     ]
    }
   ],
   "source": [
    "# Phase 3: Execute Metrics Computation\n",
    "print(\"Phase 3: Compute Metrics\")\n",
    "print(\"=\" * 50)\n",
    "\n",
    "# Compute metrics for all DGPs\n",
    "metrics_results = {}\n",
    "\n",
    "for dgp_name, data in data_dgps.items():\n",
    "    metrics = compute_metrics_for_dgp(\n",
    "        dgp_name, data[\"sequences\"], data[\"bayesian\"], model_results[dgp_name]\n",
    "    )\n",
    "    metrics_results[dgp_name] = metrics\n",
    "\n",
    "    # Print summary statistics\n",
    "    print(f\"\\n{data['name']} Summary:\")\n",
    "    print(f\"  Avg Cross-Entropy Loss: {np.mean(metrics['cross_entropy_loss']):.3f}\")\n",
    "    print(f\"  Avg KL to Bayesian: {np.mean(metrics['kl_to_bayesian']):.3f}\")\n",
    "    print(f\"  Avg KL from Uniform: {np.mean(metrics['kl_from_uniform']):.3f}\")\n",
    "    print(f\"  Positions evaluated: {len(metrics['positions'])}\")\n",
    "\n",
    "print(\"\\nPhase 3 completed successfully!\")"
   ]
  },
