    "# Plot 2: KL Divergence to Bayesian Optimal\n",
    "plt.figure(figsize=fig_size)\n",
    "for dgp_name, metrics in metrics_results.items():\n",
    "    line = plt.plot(\n",
    "        metrics[\"positions\"],\n",
    "        metrics[\"kl_to_bayesian\"],\n",
    "        label=data_dgps[dgp_name][\"name\"],\n",
    "        linewidth=2,\n",
    "        marker=\"s\",\n",
    "        markersize=3,\n",
    "    )[0]\n",
    "\n",
    "    # Add convergence annotations\n",
    "    if dgp_name == \"multinomial\":\n",
    "        # Show convergence to optimal\n",
    "        final_pos = len(metrics[\"positions\"]) - 1\n",
    "        plt.annotate(\n",
    "            \"📉 Approaching optimality\",\n",
    "            xy=(metrics[\"positions\"][final_pos], metrics[\"kl_to_bayesian\"][final_pos]),\n",
    "            xytext=(-100, 20),\n",
    "            textcoords=\"offset points\",\n",
    "            bbox=dict(boxstyle=\"round,pad=0.3\", facecolor=\"lightgreen\", alpha=0.7),\n",
    "            arrowprops=dict(arrowstyle=\"->\", color=\"green\"),\n",
    "        )\n",
    "    elif dgp_name == \"uniform\":\n",
    "        # Show stable low distance (simple task)\n",
    "        mid_pos = len(metrics[\"positions\"]) // 2\n",
    "        plt.annotate(\n",
    "            \"✨ Already optimal (simple task)\",\n",
    "            xy=(metrics[\"positions\"][mid_pos], metrics[\"kl_to_bayesian\"][mid_pos]),\n",
    "            xytext=(20, 40),\n",
    "            textcoords=\"offset points\",\n",
    "            bbox=dict(boxstyle=\"round,pad=0.3\", facecolor=\"lightblue\", alpha=0.7),\n",
    "            arrowprops=dict(arrowstyle=\"->\", color=\"blue\"),\n",
    "        )\n",
    "\n",
    "plt.xlabel(\"Sequence Position\")\n",
    "plt.ylabel(\"KL Divergence to Bayesian Optimal\")\n",
    "plt.title(\"🎯 Figure 2: Distance from Theoretical Optimum\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "# Add explanatory text\n",
    "plt.text(\n",
    "    0.02,\n",
    "    0.98,\n",
    "    \"📊 Interpretation:\\n• Lower = closer to optimal\\n• Decreasing = improving performance\\n• Flat near zero = already optimal\",\n",
    "    transform=plt.gca().transAxes,\n",
