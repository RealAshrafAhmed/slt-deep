   "source": [
    "# Summary Statistics Table\n",
    "print(\"\\nSUMMARY STATISTICS\")\n",
    "print(\"=\" * 80)\n",
    "\n",
    "summary_data = []\n",
    "for dgp_name, metrics in metrics_results.items():\n",
    "    dgp_display_name = data_dgps[dgp_name][\"name\"]\n",
    "\n",
    "    # Calculate statistics\n",
    "    initial_ce_loss = (\n",
    "        metrics[\"cross_entropy_loss\"][0] if metrics[\"cross_entropy_loss\"] else np.nan\n",
    "    )\n",
    "    final_ce_loss = (\n",
    "        metrics[\"cross_entropy_loss\"][-1] if metrics[\"cross_entropy_loss\"] else np.nan\n",
    "    )\n",
    "    ce_improvement = initial_ce_loss - final_ce_loss\n",
    "\n",
    "    initial_kl_bayes = (\n",
    "        metrics[\"kl_to_bayesian\"][0] if metrics[\"kl_to_bayesian\"] else np.nan\n",
    "    )\n",
    "    final_kl_bayes = (\n",
    "        metrics[\"kl_to_bayesian\"][-1] if metrics[\"kl_to_bayesian\"] else np.nan\n",
    "    )\n",
    "    kl_bayes_improvement = initial_kl_bayes - final_kl_bayes\n",
    "\n",
    "    avg_info_gain = (\n",
    "        np.mean(metrics[\"kl_from_uniform\"]) if metrics[\"kl_from_uniform\"] else np.nan\n",
    "    )\n",
    "\n",
    "    summary_data.append(\n",
    "        {\n",
    "            \"DGP\": dgp_display_name,\n",
    "            \"Initial CE Loss\": f\"{initial_ce_loss:.3f}\",\n",
    "            \"Final CE Loss\": f\"{final_ce_loss:.3f}\",\n",
    "            \"CE Improvement\": f\"{ce_improvement:.3f}\",\n",
    "            \"KL Bayes Improvement\": f\"{kl_bayes_improvement:.3f}\",\n",
    "            \"Avg Info Gain\": f\"{avg_info_gain:.3f}\",\n",
    "        }\n",
    "    )\n",
    "\n",
    "# Print formatted table\n",
    "for key in summary_data[0].keys():\n",
    "    print(f\"{key:20s}\", end=\"\")\n",
    "print()\n",
    "print(\"-\" * 120)\n",
    "\n",
    "for row in summary_data:\n",
    "    for key, value in row.items():\n",
    "        print(f\"{value:20s}\", end=\"\")\n",
    "    print()\n",
    "\n",
    "print(\"\\n✅ Phase 4 complete!\")"
