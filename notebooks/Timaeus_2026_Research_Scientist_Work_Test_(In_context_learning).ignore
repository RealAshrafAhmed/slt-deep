   "source": [
    "# Plot 4: Distribution Evolution Analysis\n",
    "print(\"📊 Distribution Evolution Analysis:\")\n",
    "for dgp_name in data_dgps.keys():\n",
    "    plot_distribution_comparison(dgp_name)\n",
    "    print(\n",
    "        f\"• {data_dgps[dgp_name]['name']}: Shows {'convergence' if dgp_name != 'uniform' else 'stable uniformity'} over time\"\n",
    "    )"
