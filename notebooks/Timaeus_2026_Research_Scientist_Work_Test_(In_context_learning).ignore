      "✅ Distribution comparison function defined\n"
     ]
    }
   ],
   "source": [
    "# Distribution Comparison Function\n",
    "def plot_distribution_comparison(dgp_name, seq_idx=0, positions=[5, 25, 50, 75]):\n",
    "    \"\"\"Plot model vs Bayesian distributions with convergence annotations\"\"\"\n",
    "    data = data_dgps[dgp_name]\n",
    "    sequence = data[\"sequences\"][seq_idx]\n",
    "    bayesian_dists = data[\"bayesian\"][seq_idx]\n",
    "    model_dists = model_results[dgp_name][\"model_distributions\"][seq_idx]\n",
    "\n",
    "    # Filter positions that exist in our data\n",
    "    valid_positions = [\n",
    "        p for p in positions if p < len(model_dists) and p < len(bayesian_dists)\n",
    "    ]\n",
    "\n",
    "    if not valid_positions:\n",
    "        print(f\"No valid positions for {dgp_name}\")\n",
    "        return\n",
    "\n",
    "    fig, axes = plt.subplots(\n",
    "        1, len(valid_positions), figsize=(4 * len(valid_positions), 4)\n",
    "    )\n",
    "    if len(valid_positions) == 1:\n",
    "        axes = [axes]\n",
    "\n",
    "    x = np.arange(K)\n",
    "    width = 0.35\n",
    "\n",
    "    for i, pos in enumerate(valid_positions):\n",
    "        ax = axes[i]\n",
    "\n",
    "        # Get distributions at this position\n",
    "        model_dist = model_dists[pos]\n",
    "        bayes_dist = bayesian_dists[pos]\n",
    "\n",
    "        # Plot bars with different colors for model vs optimal\n",
    "        bars1 = ax.bar(\n",
    "            x - width / 2,\n",
    "            model_dist,\n",
    "            width,\n",
    "            label=\"GPT-2 Model\",\n",
    "            alpha=0.8,\n",
    "            color=\"steelblue\",\n",
    "        )\n",
    "        bars2 = ax.bar(\n",
    "            x + width / 2,\n",
    "            bayes_dist,\n",
    "            width,\n",
    "            label=\"Bayesian Optimal\",\n",
    "            alpha=0.8,\n",
    "            color=\"orange\",\n",
    "        )\n",
    "\n",
    "        # Calculate and show convergence metric\n",
    "        kl_div = np.sum(\n",
    "            bayes_dist * np.log((bayes_dist + 1e-10) / (model_dist + 1e-10))\n",
    "        )\n",
    "\n",
    "        # Add convergence annotation\n",
    "        if kl_div < 0.5:\n",
    "            ax.text(\n",
    "                0.95,\n",
    "                0.95,\n",
    "                f\"✅ Close\\nKL={kl_div:.3f}\",\n",
    "                transform=ax.transAxes,\n",
    "                verticalalignment=\"top\",\n",
    "                horizontalalignment=\"right\",\n",
    "                bbox=dict(boxstyle=\"round,pad=0.3\", facecolor=\"lightgreen\", alpha=0.7),\n",
    "            )\n",
    "        elif kl_div < 1.0:\n",
    "            ax.text(\n",
    "                0.95,\n",
    "                0.95,\n",
    "                f\"📊 Learning\\nKL={kl_div:.3f}\",\n",
    "                transform=ax.transAxes,\n",
    "                verticalalignment=\"top\",\n",
    "                horizontalalignment=\"right\",\n",
    "                bbox=dict(boxstyle=\"round,pad=0.3\", facecolor=\"lightyellow\", alpha=0.7),\n",
    "            )\n",
    "        else:\n",
    "            ax.text(\n",
    "                0.95,\n",
    "                0.95,\n",
    "                f\"📈 Adapting\\nKL={kl_div:.3f}\",\n",
    "                transform=ax.transAxes,\n",
    "                verticalalignment=\"top\",\n",
    "                horizontalalignment=\"right\",\n",
    "                bbox=dict(boxstyle=\"round,pad=0.3\", facecolor=\"lightcoral\", alpha=0.7),\n",
    "            )\n",
    "\n",
    "        # Highlight the most probable digit for each distribution\n",
    "        model_max = np.argmax(model_dist)\n",
    "        bayes_max = np.argmax(bayes_dist)\n",
    "\n",
    "        ax.set_xlabel(\"Digit\")\n",
    "        ax.set_ylabel(\"Probability\")\n",
    "        ax.set_title(f\"Position {pos + 1}\")\n",
    "        ax.set_xticks(x)\n",
    "        ax.set_xticklabels([str(d) for d in range(K)])\n",
    "        if i == 0:  # Only show legend on first subplot\n",
    "            ax.legend()\n",
    "        ax.grid(True, alpha=0.3)\n",
    "\n",
    "    plt.suptitle(\n",
    "        f\"📊 Figure 4.{list(data_dgps.keys()).index(dgp_name) + 1}: {data['name']} - Model vs Bayesian Distributions\\n(Convergence over time)\",\n",
    "        fontsize=14,\n",
    "    )\n",
    "    plt.tight_layout(rect=[0, 0, 1, 0.92])  # Reduced gap between title and subplots\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "print(\"✅ Distribution comparison function defined\")"
   ]
  },
