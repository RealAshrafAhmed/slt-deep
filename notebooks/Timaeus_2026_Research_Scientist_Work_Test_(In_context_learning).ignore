   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## **Phase 1: Data Generation**\n",
    "\n",
    "**Three DGPs for ICL testing**:\n",
    "1. **🎲 Uniform**: Random digits (control - no pattern)\n",
    "2. **📊 Multinomial**: Fixed categorical bias (main ICL test)\n",
    "3. **🚶 Random Walk**: Local dependencies (complex ICL test)\n",
    "\n",
    "**Bayesian Baselines**: Theoretically optimal predictors for each DGP\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Phase 1.1: Data Generation Functions\n",
    "def generate_uniform_sequences(K, N, num_sequences):\n",
    "    \"\"\"Generate uniform i.i.d. sequences\"\"\"\n",
    "    sequences = []\n",
    "    bayesian_optimal = []\n",
    "\n",
    "    for _ in range(num_sequences):\n",
    "        # Sample N tokens uniformly from {0, ..., K-1}\n",
    "        sequence = np.random.randint(0, K, N)\n",
    "        sequences.append(sequence.tolist())\n",
    "\n",
    "        # Bayesian optimal: uniform distribution at every position\n",
    "        uniform_dist = np.full(K, 1.0 / K)\n",
    "        bayesian_optimal.append([uniform_dist.copy() for _ in range(N)])\n",
    "\n",
    "    return sequences, bayesian_optimal\n",
    "\n",
    "\n",
    "def generate_multinomial_sequences(K, N, num_sequences, alpha=None):\n",
    "    \"\"\"Generate non-uniform multinomial i.i.d. sequences\"\"\"\n",
    "    if alpha is None:\n",
    "        alpha = np.ones(K)  # Uniform Dirichlet prior\n",
    "\n",
    "    sequences = []\n",
    "    bayesian_optimal = []\n",
    "\n",
    "    for _ in range(num_sequences):\n",
    "        # Sample θ from Dirichlet(α)\n",
    "        theta = np.random.dirichlet(alpha)\n",
    "\n",
    "        # Sample N tokens from Categorical(θ)\n",
    "        sequence = np.random.choice(K, N, p=theta)\n",
    "        sequences.append(sequence.tolist())\n",
    "\n",
    "        # Compute Bayesian optimal at each position\n",
    "        seq_bayesian = []\n",
    "        for t in range(N):\n",
    "            # Count occurrences up to position t\n",
    "            counts = np.bincount(sequence[:t], minlength=K)\n",
    "            # Posterior predictive: (counts + α) / (t + sum(α))\n",
    "            posterior = (counts + alpha) / (t + np.sum(alpha))\n",
    "            seq_bayesian.append(posterior.copy())\n",
    "\n",
    "        bayesian_optimal.append(seq_bayesian)\n",
    "\n",
    "    return sequences, bayesian_optimal\n",
    "\n",
    "\n",
    "def generate_random_walk_sequences(K, N, num_sequences, transition_probs=None):\n",
    "    \"\"\"Generate discrete random walk sequences\"\"\"\n",
    "    if transition_probs is None:\n",
    "        # Default: step ∈ {-1, 0, +1} with probabilities [0.25, 0.5, 0.25]\n",
    "        steps = [-1, 0, 1]\n",
    "        step_probs = [0.25, 0.5, 0.25]\n",
    "    else:\n",
    "        steps, step_probs = transition_probs\n",
    "\n",
    "    sequences = []\n",
    "    bayesian_optimal = []\n",
    "\n",
    "    for _ in range(num_sequences):\n",
    "        # Start from random initial state\n",
    "        current_state = np.random.randint(0, K)\n",
    "        sequence = [current_state]\n",
    "\n",
    "        # Generate sequence by applying transitions\n",
    "        for t in range(1, N):\n",
    "            # Sample step and apply (mod K)\n",
    "            step = np.random.choice(steps, p=step_probs)\n",
    "            current_state = (current_state + step) % K\n",
    "            sequence.append(current_state)\n",
    "\n",
    "        sequences.append(sequence)\n",
    "\n",
    "        # Bayesian optimal: transition kernel applied to current state\n",
    "        seq_bayesian = []\n",
    "        for t in range(N):\n",
    "            current = sequence[t]\n",
    "            # Apply transition probabilities from current state\n",
    "            next_dist = np.zeros(K)\n",
    "            for step, prob in zip(steps, step_probs):\n",
    "                next_state = (current + step) % K\n",
    "                next_dist[next_state] += prob\n",
    "            seq_bayesian.append(next_dist.copy())\n",
    "\n",
    "        bayesian_optimal.append(seq_bayesian)\n",
    "\n",
    "    return sequences, bayesian_optimal"
   ]
  },
