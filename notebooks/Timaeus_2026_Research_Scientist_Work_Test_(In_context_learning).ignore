    "# Plot 3: Information Gained (KL from Uniform)\n",
    "plt.figure(figsize=fig_size)\n",
    "for dgp_name, metrics in metrics_results.items():\n",
    "    line = plt.plot(\n",
    "        metrics[\"positions\"],\n",
