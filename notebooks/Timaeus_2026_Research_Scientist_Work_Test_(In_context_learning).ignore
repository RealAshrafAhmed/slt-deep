    "        label=data_dgps[dgp_name][\"name\"],\n",
    "        linewidth=2,\n",
    "        marker=\"^\",\n",
    "        markersize=3,\n",
    "    )[0]\n",
    "\n",
    "    # Add information gain annotations\n",
    "    if dgp_name == \"multinomial\":\n",
    "        # Show gradual information accumulation\n",
    "        final_pos = len(metrics[\"positions\"]) - 1\n",
    "        info_gained = metrics[\"kl_from_uniform\"][final_pos]\n",
    "        plt.annotate(\n",
    "            f\"📈 Info gained: {info_gained:.3f} nats\",\n",
    "            xy=(metrics[\"positions\"][final_pos], info_gained),\n",
    "            xytext=(-120, -30),\n",
    "            textcoords=\"offset points\",\n",
    "            bbox=dict(boxstyle=\"round,pad=0.3\", facecolor=\"lightgreen\", alpha=0.7),\n",
    "            arrowprops=dict(arrowstyle=\"->\", color=\"green\"),\n",
    "        )\n",
    "    elif dgp_name == \"uniform\":\n",
    "        # Show no information (control)\n",
    "        mid_pos = len(metrics[\"positions\"]) // 2\n",
