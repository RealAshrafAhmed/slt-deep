    "        )\n",
    "    elif dgp_name == \"random_walk\":\n",
    "        # Show rapid structure detection\n",
    "        early_pos = min(20, len(metrics[\"positions\"]) - 1)\n",
    "        plt.annotate(\n",
    "            \"⚡ Quick structure detection\",\n",
    "            xy=(metrics[\"positions\"][early_pos], metrics[\"kl_from_uniform\"][early_pos]),\n",
    "            xytext=(20, 40),\n",
