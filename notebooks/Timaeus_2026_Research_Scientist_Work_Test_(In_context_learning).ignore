      "Dataset: 750 sequences, 111,750 predictions\n"
     ]
    }
   ],
   "source": [
    "# Phase 1.5: Organize Dataset\n",
    "# Store all data in structured format\n",
    "data_dgps = {\n",
    "    \"uniform\": {\n",
    "        \"sequences\": uniform_sequences,\n",
    "        \"bayesian\": uniform_bayesian,\n",
    "        \"name\": \"Uniform i.i.d.\",\n",
    "        \"description\": \"No pattern (control)\",\n",
    "        \"expected_icl\": \"None\",\n",
    "    },\n",
    "    \"multinomial\": {\n",
    "        \"sequences\": multinomial_sequences,\n",
    "        \"bayesian\": multinomial_bayesian,\n",
    "        \"name\": \"Multinomial i.i.d.\",\n",
    "        \"description\": \"Fixed categorical bias\",\n",
    "        \"expected_icl\": \"Strong\",\n",
    "    },\n",
    "    \"random_walk\": {\n",
    "        \"sequences\": random_walk_sequences,\n",
    "        \"bayesian\": random_walk_bayesian,\n",
    "        \"name\": \"Random Walk\",\n",
    "        \"description\": \"Local Markov dependencies\",\n",
    "        \"expected_icl\": \"Moderate\",\n",
    "    },\n",
    "}\n",
    "\n",
    "total_sequences = len(data_dgps) * num_sequences\n",
    "total_predictions = total_sequences * (N - 1)\n",
    "\n",
    "print(f\"Dataset: {total_sequences:,} sequences, {total_predictions:,} predictions\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## **Phase 2: Model Evaluation**\n",
    "\n",
    "**Goal**: Extract GPT-2's predictive distributions at each sequence position\n",
    "\n",
    "**Process**: Convert sequences to text → GPT-2 forward pass → Extract digit probabilities\n",
    "\n",
    "**Challenge**: Map tokens back to sequence positions for prediction extraction\n",
    "\n",
    "**Scale**: ~89,400 model evaluations across all sequences\n",
    "\n",
    "---"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "def sequence_to_string(sequence):\n",
    "    \"\"\"Convert sequence of digits to space-delimited string\"\"\"\n",
    "    return \" \".join(str(digit) for digit in sequence)\n",
    "\n",
    "\n",
    "def get_model_distributions(model, tokenizer, sequences, digit_tokens, device=\"cpu\"):\n",
    "    \"\"\"\n",
    "    Get model's predictive distributions for sequences\n",
    "\n",
    "    Returns:\n",
    "        model_distributions: List of lists of distributions (num_sequences x N x K)\n",
    "        valid_positions: List of valid position indices for each sequence\n",
    "    \"\"\"\n",
    "    model.to(device)\n",
    "    model_distributions = []\n",
    "    valid_positions_list = []\n",
    "\n",
    "    total_sequences = len(sequences)\n",
    "    print(f\"Processing {total_sequences:,} sequences...\")\n",
    "\n",
    "    with torch.no_grad():\n",
    "        for i, sequence in enumerate(sequences):\n",
    "            if (i + 1) % 50 == 0 or i == 0:\n",
    "                progress = (i + 1) / total_sequences * 100\n",
    "                print(f\"Progress: {i + 1:,}/{total_sequences:,} ({progress:.1f}%)\")\n",
    "\n",
    "            # Convert to string and tokenize\n",
    "            seq_string = sequence_to_string(sequence)\n",
    "            input_ids = tokenizer.encode(seq_string, return_tensors=\"pt\").to(device)\n",
    "\n",
    "            # Forward pass\n",
    "            outputs = model(input_ids)\n",
    "            logits = outputs.logits[0]  # Shape: (seq_len, vocab_size)\n",
    "\n",
    "            # Decode tokens to understand structure\n",
    "            tokens = input_ids[0].tolist()\n",
    "            decoded_tokens = [tokenizer.decode([token]) for token in tokens]\n",
    "\n",
    "            # Find positions corresponding to digit tokens (not delimiters)\n",
    "            digit_positions = []\n",
    "            sequence_distributions = []\n",
    "\n",
    "            # Map tokens back to sequence positions\n",
    "            seq_idx = 0\n",
    "            for pos, (token_id, decoded) in enumerate(zip(tokens, decoded_tokens)):\n",
    "                # Check if this token corresponds to a digit in our sequence\n",
    "                if (\n",
    "                    seq_idx < len(sequence)\n",
    "                    and str(sequence[seq_idx]) == decoded.strip()\n",
    "                ):\n",
    "                    digit_positions.append(pos)\n",
    "                    seq_idx += 1\n",
    "                elif decoded.strip() in [str(d) for d in range(10)]:\n",
    "                    # This is a digit token, might be part of our sequence\n",
    "                    digit_positions.append(pos)\n",
    "                    seq_idx += 1\n",
    "\n",
    "            # For each digit position, get model's distribution over digit tokens\n",
    "            for pos_idx, token_pos in enumerate(\n",
    "                digit_positions[:-1]\n",
    "            ):  # Exclude last position (no next token)\n",
    "                if token_pos + 1 < len(\n",
    "                    logits\n",
    "                ):  # Make sure we have logits for next position\n",
    "                    # Extract logits for the K digit token IDs\n",
    "                    next_logits = logits[token_pos]  # Logits for predicting next token\n",
    "                    digit_logits = torch.stack(\n",
    "                        [next_logits[digit_tokens[d]] for d in range(K)]\n",
    "                    )\n",
    "\n",
    "                    # Apply softmax to get distribution\n",
    "                    digit_probs = softmax(digit_logits, dim=0).cpu().numpy()\n",
    "                    sequence_distributions.append(digit_probs)\n",
    "\n",
    "            model_distributions.append(sequence_distributions)\n",
    "            valid_positions_list.append(list(range(len(sequence_distributions))))\n",
    "\n",
    "    return model_distributions, valid_positions_list"
   ]
  },
