# .gitignore for uv monorepo

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.tox/
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.nbconvert.ipynb

# Research artifacts
*.pkl
*.pickle
*.pth
*.h5
*.hdf5
*.npz
*.joblib

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.log
*.out
*.synctex.gz
*.toc
*.lot
*.lof
*.idx
*.ind
*.ilg
*.nav
*.snm
*.vrb
*.figlist
*.makefile
*.fignore

# Generated papers (keep source, ignore output)
papers/*.pdf
papers/figures/
papers/build/

# Mill build artifacts
out/mill-build/
out/mill-launcher/
out/mill-server/
out/mill-lock
out/mill-runner-state.json

# Experiment tracking
wandb/
mlruns/
.neptune/
outputs/

# Logs and outputs
*.log
*.out
*.err
slurm-*.out

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDEs
.idea/
*.sublime-*

# VSCode (but keep settings.json and extensions.json)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.vscode/settings.json
skeletons-monorepo-for-research.code-workspace

# Environment
.env
.envrc
